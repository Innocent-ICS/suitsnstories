generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  COACH
  PERCEPTION_ENGINEER
  PROGRAM_MANAGER
  ADMIN
}

// ── Auth Models ────────────────────────────────────────────────────────

model User {
  id                         String                 @id @default(cuid())
  name                       String?
  email                      String?                @unique
  password                   String?
  emailVerified              DateTime?
  image                      String?
  role                       UserRole               @default(CLIENT)
  accounts                   Account[]
  sessions                   Session[]
  emailVerificationTokens    EmailVerificationToken[]
  profile                    Profile?
  enrollments                Enrollment[]
  quizAttempts               QuizAttempt[]
  payments                   Payment[]
  availability               Availability[]         @relation("CoachAvailability")
  clientBookings             Booking[]              @relation("ClientBookings")
  coachBookings              Booking[]              @relation("CoachBookings")
  ownedProjects              Project[]              @relation("ProjectOwner")
  assignedProjects           Project[]              @relation("ProjectCoach")
  projectCollaborations      ProjectCollaborator[]  @relation("ProjectCollaboratorUser")
  sentProjectCollaborations  ProjectCollaborator[]  @relation("ProjectCollaboratorInviter")
  sentProjectInvitations     ProjectInvitation[]    @relation("ProjectInvitationInviter")
  acceptedProjectInvitations ProjectInvitation[]    @relation("ProjectInvitationAcceptedBy")
  securityAuditLogs          SecurityAuditLog[]     @relation("SecurityAuditActor")
  comments                   ProjectComment[]
  managedAcceleratorPrograms AcceleratorProgram[]   @relation("ProgramManager")
  programMemberships         ProgramMember[]
  perceptoscopeAnalyses      PerceptoscopeAnalysis[]
  recommendations            Recommendation[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

// ── User Profile ───────────────────────────────────────────────────────

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  company     String?
  industry    String?
  avatarUrl   String?
  linkedinUrl String?
  timezone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Business Models ────────────────────────────────────────────────────

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ── LMS Models ─────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  TEXT
  VIDEO
  QUIZ
}

model Course {
  id                  String               @id @default(cuid())
  title               String
  slug                String               @unique
  description         String?
  thumbnail           String?
  status              CourseStatus         @default(DRAFT)
  price               Int                  @default(0) // Price in cents (0 = free)
  currency            String               @default("GHS")
  modules             Module[]
  enrollments         Enrollment[]
  acceleratorPrograms AcceleratorProgram[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([slug])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, order])
}

model Lesson {
  id            String           @id @default(cuid())
  moduleId      String
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  type          LessonType       @default(TEXT)
  content       String? // Rich text / markdown for TEXT type
  videoUrl      String? // External video URL for VIDEO type
  videoDuration Int? // Duration in seconds
  quizData      Json? // Quiz questions/answers for QUIZ type
  order         Int              @default(0)
  isFree        Boolean          @default(false) // Free preview lessons
  progress      LessonProgress[]
  quizAttempts  QuizAttempt[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([moduleId, order])
}

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentId      String? // Null if free course
  payment        Payment?         @relation(fields: [paymentId], references: [id])
  progress       LessonProgress[]
  programMembers ProgramMember[]
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers   Json // User's submitted answers
  score     Float // Percentage score (0-100)
  passed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, lessonId])
}

// ── Payments ───────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount              Int // Amount in cents
  currency            String               @default("GHS")
  status              PaymentStatus        @default(PENDING)
  provider            String               @default("paystack")
  providerRef         String? // PayStack reference
  providerData        Json? // Full provider response
  enrollments         Enrollment[]
  bookings            Booking[]
  acceleratorPrograms AcceleratorProgram[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
  @@index([providerRef])
}

// ── Booking System ─────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model ServiceOffering {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  duration    Int // Duration in minutes
  price       Int       @default(0) // Price in cents (0 = free)
  currency    String    @default("ZAR")
  isActive    Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model Availability {
  id        String   @id @default(cuid())
  coachId   String
  coach     User     @relation("CoachAvailability", fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday, 6 = Saturday
  startTime String // "09:00" (HH:mm format)
  endTime   String // "17:00"
  timezone  String   @default("Africa/Johannesburg")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId, dayOfWeek])
}

model Booking {
  id           String          @id @default(cuid())
  clientId     String
  client       User            @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  coachId      String
  coach        User            @relation("CoachBookings", fields: [coachId], references: [id], onDelete: Cascade)
  serviceId    String
  service      ServiceOffering @relation(fields: [serviceId], references: [id])
  paymentId    String?
  payment      Payment?        @relation(fields: [paymentId], references: [id])
  status       BookingStatus   @default(PENDING)
  startTime    DateTime
  endTime      DateTime
  timezone     String          @default("Africa/Johannesburg")
  notes        String? // Client notes when booking
  coachNotes   String? // Coach-only notes
  meetingUrl   String? // Video call link
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clientId, status])
  @@index([coachId, status])
  @@index([startTime])
}

// ── Project Management ─────────────────────────────────────────────────

enum ProjectStatus {
  BRIEF
  IN_PROGRESS
  REVIEW
  REVISION
  COMPLETED
  ARCHIVED
}

enum ProjectCollaboratorRole {
  VIEWER
  COMMENTER
  EDITOR
}

enum ProjectInvitationScope {
  ANYONE
  COMPANY
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Project {
  id                   String                 @id @default(cuid())
  title                String
  description          String?
  status               ProjectStatus          @default(BRIEF)
  clientId             String
  client               User                   @relation("ProjectOwner", fields: [clientId], references: [id], onDelete: Cascade)
  coachId              String?
  coach                User?                  @relation("ProjectCoach", fields: [coachId], references: [id])
  brief                String? // Client's pitch brief / context
  feedback             String? // Coach's latest feedback
  dueDate              DateTime?
  deliverables         Deliverable[]
  comments             ProjectComment[]
  collaborators        ProjectCollaborator[]
  invitations          ProjectInvitation[]
  perceptoscopeAnalyses PerceptoscopeAnalysis[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([clientId])
  @@index([coachId])
  @@index([status])
}

model ProjectCollaborator {
  id          String                  @id @default(cuid())
  projectId   String
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation("ProjectCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User                    @relation("ProjectCollaboratorInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  role        ProjectCollaboratorRole @default(EDITOR)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvitation {
  id           String                  @id @default(cuid())
  projectId    String
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User                    @relation("ProjectInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedById String?
  acceptedBy   User?                   @relation("ProjectInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  email        String?
  tokenHash    String                  @unique
  role         ProjectCollaboratorRole @default(VIEWER)
  scope        ProjectInvitationScope  @default(ANYONE)
  status       ProjectInvitationStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([projectId, status])
  @@index([email])
  @@index([expiresAt])
}

model Deliverable {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String? // Supabase Storage URL
  fileType   String? // MIME type
  fileSize   Int? // bytes
  version    Int       @default(1)
  approved   Boolean   @default(false)
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([projectId])
}

// ── Accelerator Programs ───────────────────────────────────────────────

enum AcceleratorProgramStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProgramMemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

model AcceleratorProgram {
  id             String                   @id @default(cuid())
  name           String
  company        String
  managerId      String
  manager        User                     @relation("ProgramManager", fields: [managerId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentId      String?
  payment        Payment?                 @relation(fields: [paymentId], references: [id])
  seatsPurchased Int
  packagePrice   Int                      @default(0)
  currency       String                   @default("GHS")
  status         AcceleratorProgramStatus @default(PENDING_PAYMENT)
  notes          String?
  members        ProgramMember[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([managerId])
  @@index([courseId])
  @@index([status])
}

model ProgramMember {
  id           String              @id @default(cuid())
  programId    String
  program      AcceleratorProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollmentId String?
  enrollment   Enrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  name         String?
  email        String
  status       ProgramMemberStatus @default(INVITED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([programId, email])
  @@index([userId])
  @@index([programId, status])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// ── Perceptoscope Pitch Diagnosis ───────────────────────────────────────

enum PerceptoscopeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("NarratometerStatus")
}

enum PerceptoscopeAgentKind {
  EXTRACTOR
  NARRATIVE
  INVESTOR_READINESS
  DESIGN_SYSTEM
  GUARDRAIL
  ORCHESTRATOR

  @@map("NarratometerAgentKind")
}

enum PerceptoscopeProvider {
  GROQ
  OPENROUTER

  @@map("NarratometerProvider")
}

model PerceptoscopeAnalysis {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String
  founderContext  String?
  fileName        String
  fileMimeType    String
  fileSize        Int
  fileFingerprint String
  provider        PerceptoscopeProvider?
  model           String?
  status          PerceptoscopeStatus     @default(PENDING)
  score           Int?
  riskLevel       String?
  summary         String?
  report          Json?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  agentRuns       PerceptoscopeAgentRun[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([status])
  @@index([fileFingerprint])
  @@map("NarratometerAnalysis")
}

model PerceptoscopeAgentRun {
  id          String                @id @default(cuid())
  analysisId  String
  analysis    PerceptoscopeAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  kind        PerceptoscopeAgentKind
  provider    PerceptoscopeProvider?
  model       String?
  status      PerceptoscopeStatus    @default(PENDING)
  summary     String?
  findings    Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([analysisId, kind])
  @@index([status])
  @@map("NarratometerAgentRun")
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
  @@index([createdAt])
}

model SecurityAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("SecurityAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  outcome    String   @default("SUCCESS")
  ipHash     String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ── Recommendations / Testimonials ──────────────────────────────────────

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Recommendation {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String               // The recommendation body (max ~1000 chars)
  stars      Int                  @default(5) // 1-5 star rating
  role       String?              // Optional role override e.g. "CEO, Todoke"
  status     RecommendationStatus @default(PENDING)
  featured   Boolean              @default(false)
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status])
  @@index([userId])
}
